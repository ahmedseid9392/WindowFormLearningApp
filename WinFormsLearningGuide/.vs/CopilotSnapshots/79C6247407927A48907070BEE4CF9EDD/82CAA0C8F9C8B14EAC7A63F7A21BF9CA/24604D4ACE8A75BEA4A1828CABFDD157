using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Drawing;
using System.Windows.Forms;
using WinFormsLearningGuide.Helpers;
using WinFormsLearningGuide.Models;

namespace WinFormsLearningGuide.Controls;

/// <summary>
/// A custom-painted card with a heading and a stack of content blocks
/// (paragraphs, bullets, mistake/fix pairs, images, captions, fields, code blocks and tables).
/// Its height follows its width and content, so it can be stacked in a scrolling panel.
/// Block positions are measured once per width and cached, so painting only touches the blocks
/// that are actually visible (important for the long Properties Reference card).
/// </summary>
public class SectionCard : Control, IThemeable
{
    private const TextFormatFlags TextFlags =
        TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix | TextFormatFlags.Left |
        TextFormatFlags.Top | TextFormatFlags.NoPadding;

    private readonly Font _bodyFont;
    private readonly Font _boldFont;
    private readonly Font _headFont;
    private readonly Font _badgeFont;
    private readonly Font _captionFont;
    private readonly Font _labelFont;
    private readonly Font _monoFont;
    private readonly Font _monoBoldFont;
    private readonly Font _tableFont;
    private readonly Font _tableBoldFont;
    private readonly Font _tableMonoFont;
    private readonly List<ContentBlock> _blocks = new List<ContentBlock>();

    // Layout cache: _blockEnd[i] is the y position (relative to the body) after block i.
    private readonly List<int> _blockEnd = new List<int>();
    private int _measuredWidth = -1;
    private int _clipTop = int.MinValue;
    private int _clipBottom = int.MaxValue;

    private string _heading = "";
    private string _badge = "";

    public SectionCard()
    {
        SetStyle(ControlStyles.Selectable, false);
        SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint |
                 ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw, true);
        TabStop = false;

        _bodyFont = new Font("Segoe UI", 10F);
        _boldFont = new Font("Segoe UI Semibold", 10F);
        _headFont = new Font("Segoe UI Semibold", 12.5F);
        _badgeFont = new Font("Segoe UI", 8.5F);
        _captionFont = new Font("Segoe UI", 8.5F);
        _labelFont = new Font("Segoe UI Semibold", 9F);
        _monoFont = new Font("Consolas", 9.5F);
        _monoBoldFont = new Font("Consolas", 10.5F, FontStyle.Bold);
        _tableFont = new Font("Segoe UI", 9.5F);
        _tableBoldFont = new Font("Segoe UI Semibold", 9.5F);
        _tableMonoFont = new Font("Consolas", 9F);
        Font = _bodyFont;
        Height = 80;
    }

    public string Heading
    {
        get => _heading;
        set { _heading = value ?? ""; Invalidate(); }
    }

    public string Badge
    {
        get => _badge;
        set { _badge = value ?? ""; Invalidate(); }
    }

    /// <summary>Convenience: shows plain wrapped text (a single paragraph).</summary>
    public string Body
    {
        get => _blocks.Count == 1 && _blocks[0].Kind == BlockKind.Paragraph ? _blocks[0].Text : "";
        set => SetBlocks(new[] { ContentBlock.Paragraph(value ?? "") });
    }

    /// <summary>Replaces the content. The card takes ownership of any images and disposes them.</summary>
    public void SetBlocks(IEnumerable<ContentBlock> blocks)
    {
        DisposeImages();
        _blocks.Clear();
        _blockEnd.Clear();
        _measuredWidth = -1;
        if (blocks != null) _blocks.AddRange(blocks);
        UpdateHeight();
        Invalidate();
    }

    public void ApplyTheme(Theme theme) => Invalidate();

    protected override void OnMouseDown(MouseEventArgs e)
    {
        Parent?.Focus();
        base.OnMouseDown(e);
    }

    protected override void OnResize(EventArgs e)
    {
        base.OnResize(e);
        UpdateHeight();
    }

    private int Scale(int value) => ThemeHelper.Scale(this, value);

    private void UpdateHeight()
    {
        if (Width <= 0) return;
        int h = BodyTop() + Flow(null, Width, ThemeHelper.Current) + Scale(18);
        if (h != Height) Height = h;
    }

    private int PadX() => Scale(22);
    private int BodyTop() => Scale(14) + _headFont.Height + Scale(8);

    // ------------------------------------------------------------------ layout / painting

    /// <summary>
    /// Lays out all blocks for the given card width. Paints when <paramref name="g"/> is not null
    /// (skipping blocks outside the clip rectangle when the layout cache is valid).
    /// Passing null only measures and refreshes the cache. Returns the total height of the block stack.
    /// </summary>
    private int Flow(Graphics g, int cardWidth, Theme t)
    {
        int padX = PadX();
        int textWidth = Math.Max(40, cardWidth - padX * 2);
        int indent = Scale(18);
        int gap = Scale(6);
        int bodyTop = BodyTop();
        int y = 0;
        bool first = true;

        bool measuring = g == null;
        bool useCache = !measuring && _measuredWidth == cardWidth && _blockEnd.Count == _blocks.Count;
        if (measuring) _blockEnd.Clear();

        for (int i = 0; i < _blocks.Count; i++)
        {
            ContentBlock block = _blocks[i];

            if (useCache)
            {
                int end = _blockEnd[i];
                if (bodyTop + end < _clipTop || bodyTop + y > _clipBottom)
                {
                    y = end;          // off screen: skip measuring and drawing
                    first = false;
                    continue;
                }
            }

            switch (block.Kind)
            {
                case BlockKind.Paragraph:
                    y += DrawText(g, block.Text, _bodyFont, t.Text, padX, y, textWidth) + gap;
                    break;

                case BlockKind.Note:
                    y += DrawText(g, block.Text, _bodyFont, t.TextMuted, padX, y, textWidth) + gap;
                    break;

                case BlockKind.SubHeading:
                    if (!first) y += gap + Scale(4);
                    y += DrawText(g, block.Text, _boldFont, t.Accent, padX, y, textWidth) + gap;
                    break;

                case BlockKind.Bullet:
                    DrawGlyph(g, "•", t.TextMuted, padX + Scale(4), y);
                    y += DrawText(g, block.Text, _bodyFont, t.Text, padX + indent, y, textWidth - indent) + gap;
                    break;

                case BlockKind.Mistake:
                    DrawGlyph(g, "✗", ErrorColor(t), padX, y);
                    y += DrawText(g, block.Text, _boldFont, t.Text, padX + indent, y, textWidth - indent) + Scale(2);
                    break;

                case BlockKind.Fix:
                    DrawGlyph(g, "✓", SuccessColor(t), padX + indent, y);
                    y += DrawText(g, block.Text, _bodyFont, t.Text, padX + indent * 2, y, textWidth - indent * 2)
                         + gap + Scale(4);
                    break;

                case BlockKind.Image:
                    y += DrawImage(g, block.Image, padX, y, textWidth, t) + gap;
                    break;

                case BlockKind.Caption:
                    y += DrawText(g, block.Text, _captionFont, t.TextMuted, padX, y, textWidth) + gap + Scale(4);
                    break;

                case BlockKind.Title:
                    if (!first)
                    {
                        y += Scale(8);
                        if (g != null)
                        {
                            using (var pen = new Pen(t.Border))
                                g.DrawLine(pen, padX, bodyTop + y, padX + textWidth, bodyTop + y);
                        }
                        y += Scale(10);
                    }
                    y += DrawText(g, block.Text, _monoBoldFont, t.Text, padX, y, textWidth) + gap;
                    break;

                case BlockKind.Field:
                {
                    int labelWidth = Math.Min(Scale(118), textWidth / 3);
                    int labelHeight = DrawText(g, block.Label, _labelFont, t.TextMuted, padX, y, labelWidth);
                    int valueHeight = DrawText(g, block.Text, _bodyFont, t.Text, padX + labelWidth, y, textWidth - labelWidth);
                    y += Math.Max(labelHeight, valueHeight) + Scale(3);
                    break;
                }

                case BlockKind.Code:
                    y += DrawCode(g, block.Text, padX, y, textWidth, t) + gap;
                    break;

                case BlockKind.Table:
                    y += DrawTable(g, block, padX, y, textWidth, t) + gap + Scale(4);
                    break;
            }

            if (measuring) _blockEnd.Add(y);
            first = false;
        }

        if (measuring) _measuredWidth = cardWidth;
        return y;
    }

    private int DrawText(Graphics g, string text, Font font, Color color, int x, int y, int width)
    {
        if (string.IsNullOrEmpty(text)) return 0;
        width = Math.Max(20, width);
        Size size = TextRenderer.MeasureText(text, font, new Size(width, int.MaxValue), TextFlags);
        if (g != null)
        {
            var rect = new Rectangle(x, BodyTop() + y, width, size.Height);
            TextRenderer.DrawText(g, text, font, rect, color, TextFlags);
        }
        return size.Height;
    }

    private void DrawGlyph(Graphics g, string glyph, Color color, int x, int y)
    {
        if (g == null) return;
        var rect = new Rectangle(x, BodyTop() + y, Scale(20), _bodyFont.Height + 2);
        TextRenderer.DrawText(g, glyph, _boldFont, rect, color,
            TextFormatFlags.Left | TextFormatFlags.NoPrefix | TextFormatFlags.NoPadding);
    }

    private int DrawImage(Graphics g, Image image, int x, int y, int maxWidth, Theme t)
    {
        if (image == null) return 0;
        int w = image.Width;
        int h = image.Height;
        if (w > maxWidth)
        {
            h = (int)Math.Round(h * (double)maxWidth / w);
            w = maxWidth;
        }
        if (g != null)
        {
            var rect = new Rectangle(x, BodyTop() + y, w, h);
            g.DrawImage(image, rect);
            using (var pen = new Pen(t.Border))
                g.DrawRectangle(pen, rect.X, rect.Y, rect.Width - 1, rect.Height - 1);
        }
        return h;
    }

    /// <summary>A monospaced block on a dark/light "input" background. Returns its height.</summary>
    private int DrawCode(Graphics g, string text, int x, int y, int width, Theme t)
    {
        if (string.IsNullOrEmpty(text)) return 0;
        int pad = Scale(8);
        int innerWidth = Math.Max(40, width - pad * 2);
        Size size = TextRenderer.MeasureText(text, _monoFont, new Size(innerWidth, int.MaxValue), TextFlags);
        int height = size.Height + pad * 2;

        if (g != null)
        {
            var rect = new Rectangle(x, BodyTop() + y, width, height);
            using (var back = new SolidBrush(t.InputBack))
                g.FillRectangle(back, rect);
            using (var pen = new Pen(t.Border))
                g.DrawRectangle(pen, rect.X, rect.Y, rect.Width - 1, rect.Height - 1);
            var textRect = new Rectangle(x + pad, rect.Y + pad, innerWidth, size.Height);
            TextRenderer.DrawText(g, text, _monoFont, textRect, t.Text, TextFlags);
        }
        return height;
    }

    // ------------------------------------------------------------------ tables

    private int DrawTable(Graphics g, ContentBlock table, int x, int y, int width, Theme t)
    {
        if (table.Header == null || table.Header.Length == 0) return 0;

        int columns = table.Header.Length;
        int padX = Scale(8);
        int padY = Scale(5);
        int[] widths = ColumnWidths(table.Weights, columns, width);
        int top = BodyTop() + y;
        int total = 0;

        int rowHeight = RowHeight(table.Header, widths, padX, padY, table.Mono, true);
        if (g != null)
            DrawRow(g, table.Header, widths, x, top + total, rowHeight, padX, padY, table.Mono, true, false, t);
        total += rowHeight;

        int rowCount = table.Rows == null ? 0 : table.Rows.Count;
        for (int r = 0; r < rowCount; r++)
        {
            string[] cells = table.Rows[r];
            rowHeight = RowHeight(cells, widths, padX, padY, table.Mono, false);
            int rowTop = top + total;
            if (g != null && rowTop + rowHeight >= _clipTop && rowTop <= _clipBottom)
                DrawRow(g, cells, widths, x, rowTop, rowHeight, padX, padY, table.Mono, false, r % 2 == 1, t);
            total += rowHeight;
        }

        if (g != null)
        {
            using (var pen = new Pen(t.Border))
                g.DrawRectangle(pen, x, top, width - 1, total - 1);
        }
        return total;
    }

    private static int[] ColumnWidths(int[] weights, int columns, int width)
    {
        var result = new int[columns];
        int sum = 0;
        for (int i = 0; i < columns; i++)
            sum += weights != null && i < weights.Length ? Math.Max(1, weights[i]) : 1;

        int used = 0;
        for (int i = 0; i < columns - 1; i++)
        {
            int weight = weights != null && i < weights.Length ? Math.Max(1, weights[i]) : 1;
            result[i] = width * weight / sum;
            used += result[i];
        }
        result[columns - 1] = width - used;
        return result;
    }

    private Font CellFont(int column, bool[] mono, bool header)
    {
        if (header) return _tableBoldFont;
        return mono != null && column < mono.Length && mono[column] ? _tableMonoFont : _tableFont;
    }

    private int RowHeight(string[] cells, int[] widths, int padX, int padY, bool[] mono, bool header)
    {
        int max = 0;
        for (int c = 0; c < widths.Length; c++)
        {
            string text = cells != null && c < cells.Length ? cells[c] ?? "" : "";
            Font font = CellFont(c, mono, header);
            int h = text.Length == 0
                ? font.Height
                : TextRenderer.MeasureText(text, font, new Size(Math.Max(10, widths[c] - padX * 2), int.MaxValue), TextFlags).Height;
            if (h > max) max = h;
        }
        return max + padY * 2;
    }

    private void DrawRow(Graphics g, string[] cells, int[] widths, int x, int top, int height,
                         int padX, int padY, bool[] mono, bool header, bool alternate, Theme t)
    {
        int totalWidth = 0;
        foreach (int w in widths) totalWidth += w;

        if (header || alternate)
        {
            using (var back = new SolidBrush(header ? t.Hover : t.Background))
                g.FillRectangle(back, x, top, totalWidth, height);
        }
        using (var pen = new Pen(t.Border))
            g.DrawLine(pen, x, top, x + totalWidth, top);

        int cellX = x;
        for (int c = 0; c < widths.Length; c++)
        {
            string text = cells != null && c < cells.Length ? cells[c] ?? "" : "";
            if (text.Length > 0)
            {
                Color color = header ? t.Text
                            : c == 0 && mono != null && mono.Length > 0 && mono[0] ? t.Accent
                            : t.Text;
                var rect = new Rectangle(cellX + padX, top + padY, Math.Max(10, widths[c] - padX * 2), height - padY * 2);
                TextRenderer.DrawText(g, text, CellFont(c, mono, header), rect, color, TextFlags);
            }
            cellX += widths[c];
        }
    }

    // ------------------------------------------------------------------ misc

    private static Color ErrorColor(Theme t) => t.IsDark ? ColorTranslator.FromHtml("#F0716A") : ColorTranslator.FromHtml("#CF222E");
    private static Color SuccessColor(Theme t) => t.IsDark ? ColorTranslator.FromHtml("#56D364") : ColorTranslator.FromHtml("#1A7F37");

    protected override void OnPaint(PaintEventArgs e)
    {
        Theme t = ThemeHelper.Current;
        Graphics g = e.Graphics;
        int padX = PadX();
        int padY = Scale(14);

        _clipTop = e.ClipRectangle.Top;
        _clipBottom = e.ClipRectangle.Bottom;

        using (var bg = new SolidBrush(t.Surface))
            g.FillRectangle(bg, ClientRectangle);
        using (var pen = new Pen(t.Border))
            g.DrawRectangle(pen, 0, 0, Width - 1, Height - 1);
        using (var accent = new SolidBrush(t.Accent))
            g.FillRectangle(accent, 0, 0, Scale(4), Height);

        var headRect = new Rectangle(padX, padY, Width - padX * 2, _headFont.Height);
        TextRenderer.DrawText(g, _heading, _headFont, headRect, t.Text,
            TextFormatFlags.Left | TextFormatFlags.NoPrefix | TextFormatFlags.NoPadding | TextFormatFlags.EndEllipsis);

        if (_badge.Length > 0)
        {
            TextRenderer.DrawText(g, _badge, _badgeFont, headRect, t.TextMuted,
                TextFormatFlags.Right | TextFormatFlags.NoPrefix | TextFormatFlags.NoPadding | TextFormatFlags.VerticalCenter);
        }

        Flow(g, Width, t);
    }

    private void DisposeImages()
    {
        foreach (ContentBlock block in _blocks)
            block.Image?.Dispose();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            DisposeImages();
            _blocks.Clear();
            _bodyFont.Dispose();
            _boldFont.Dispose();
            _headFont.Dispose();
            _badgeFont.Dispose();
            _captionFont.Dispose();
            _labelFont.Dispose();
            _monoFont.Dispose();
            _monoBoldFont.Dispose();
            _tableFont.Dispose();
            _tableBoldFont.Dispose();
            _tableMonoFont.Dispose();
        }
        base.Dispose(disposing);
    }
}
