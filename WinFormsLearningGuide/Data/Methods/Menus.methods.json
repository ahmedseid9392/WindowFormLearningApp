[
  {
    "name": "MenuStrip",
    "methods": [
      {
        "name": "Items.Add",
        "signature": "int Items.Add(ToolStripItem value)",
        "returnType": "int",
        "returnDescription": "The index of the new item.",
        "description": "Adds a menu or other item to the end of the strip.",
        "parameters": [
          {
            "name": "value",
            "type": "ToolStripItem",
            "description": "The item to add, usually a ToolStripMenuItem."
          }
        ],
        "example": "menuMain.Items.Add(new ToolStripMenuItem(\"&File\"));",
        "expectedEffect": "A File menu appears on the bar."
      },
      {
        "name": "Items.AddRange",
        "signature": "void Items.AddRange(ToolStripItem[] toolStripItems)",
        "returnType": "void",
        "returnDescription": "",
        "description": "Adds several items at once.",
        "parameters": [
          {
            "name": "toolStripItems",
            "type": "ToolStripItem[]",
            "description": "The items to add."
          }
        ],
        "example": "menuMain.Items.AddRange(new ToolStripItem[] { mnuFile, mnuEdit, mnuHelp });",
        "expectedEffect": "All three menus appear."
      },
      {
        "name": "GetItemAt",
        "signature": "ToolStripItem GetItemAt(int x, int y)",
        "returnType": "ToolStripItem",
        "returnDescription": "The item at that point, or null.",
        "description": "Finds the item under a point (relative to the strip).",
        "parameters": [
          {
            "name": "x",
            "type": "int",
            "description": "X coordinate."
          },
          {
            "name": "y",
            "type": "int",
            "description": "Y coordinate."
          }
        ],
        "example": "ToolStripItem item = menuMain.GetItemAt(10, 5);",
        "expectedEffect": "Returns the item at that position or null."
      }
    ]
  },
  {
    "name": "ContextMenuStrip",
    "methods": [
      {
        "name": "Show",
        "signature": "void Show(Control control, Point position)",
        "returnType": "void",
        "returnDescription": "",
        "description": "Shows the menu at a position relative to a control.",
        "parameters": [
          {
            "name": "control",
            "type": "Control",
            "description": "The control the position refers to."
          },
          {
            "name": "position",
            "type": "Point",
            "description": "Where to show the menu."
          }
        ],
        "example": "ctxMenu.Show(btnMore, new Point(0, btnMore.Height));",
        "expectedEffect": "The menu pops up below the button."
      },
      {
        "name": "Close",
        "signature": "void Close()",
        "returnType": "void",
        "returnDescription": "",
        "description": "Closes the menu.",
        "parameters": [],
        "example": "ctxMenu.Close();",
        "expectedEffect": "The menu disappears."
      },
      {
        "name": "Items.Add",
        "signature": "ToolStripItem Items.Add(string text)",
        "returnType": "ToolStripItem",
        "returnDescription": "The item that was created.",
        "description": "Creates a menu item with the given text and adds it.",
        "parameters": [
          {
            "name": "text",
            "type": "string",
            "description": "The caption of the new item."
          }
        ],
        "example": "ToolStripItem copy = ctxMenu.Items.Add(\"Copy\");\ncopy.Click += (s, e) => txtEditor.Copy();",
        "expectedEffect": "A \"Copy\" entry appears in the menu."
      }
    ]
  },
