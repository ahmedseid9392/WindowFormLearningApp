[
  {
    "name": "Panel",
    "methods": [
      {
        "name": "ScrollControlIntoView",
        "returnType": "void",
        "signature": "void ScrollControlIntoView(Control activeControl)",
        "description": "Scrolls an AutoScroll panel so that a child control is visible.",
        "parameters": [
          {
            "name": "activeControl",
            "type": "Control",
            "description": "The child control to bring into view."
          }
        ],
        "returns": "Nothing.",
        "example": "pnlContent.ScrollControlIntoView(btnLast);"
      },
      {
        "name": "SetAutoScrollMargin",
        "returnType": "void",
        "signature": "void SetAutoScrollMargin(int x, int y)",
        "description": "Sets the space kept around the child controls when scrolling.",
        "parameters": [
          {
            "name": "x",
            "type": "int",
            "description": "Horizontal margin in pixels."
          },
          {
            "name": "y",
            "type": "int",
            "description": "Vertical margin in pixels."
          }
        ],
        "returns": "Nothing.",
        "example": "pnlContent.SetAutoScrollMargin(10, 10);"
      }
    ]
  },
  {
    "name": "TabControl",
    "methods": [
      {
        "name": "SelectTab",
        "returnType": "void",
        "signature": "void SelectTab(int index)",
        "description": "Makes a page the visible one.",
        "parameters": [
          {
            "name": "index",
            "type": "int",
            "description": "The zero-based index of the page."
          }
        ],
        "returns": "Nothing.",
        "example": "tabMain.SelectTab(1);"
      },
      {
        "name": "DeselectTab",
        "returnType": "void",
        "signature": "void DeselectTab(int index)",
        "description": "Deselects a page and selects the next one.",
        "parameters": [
          {
            "name": "index",
            "type": "int",
            "description": "The zero-based index of the page."
          }
        ],
        "returns": "Nothing.",
        "example": "tabMain.DeselectTab(0);"
      }
    ]
  },
  {
    "name": "FlowLayoutPanel",
    "methods": [
      {
        "name": "SetFlowBreak",
        "returnType": "void",
        "signature": "void SetFlowBreak(Control control, bool value)",
        "description": "Forces a line break after a child control.",
        "parameters": [
          {
            "name": "control",
            "type": "Control",
            "description": "The child control."
          },
          {
            "name": "value",
            "type": "bool",
            "description": "true to start a new row (or column) after the control."
          }
        ],
        "returns": "Nothing.",
        "example": "flow.SetFlowBreak(btnFirst, true);"
      },
      {
        "name": "GetFlowBreak",
        "returnType": "bool",
        "signature": "bool GetFlowBreak(Control control)",
        "description": "Tells whether a line break follows a child control.",
        "parameters": [
          {
            "name": "control",
            "type": "Control",
            "description": "The child control."
          }
        ],
        "returns": "true if a flow break is set.",
        "example": "bool breaks = flow.GetFlowBreak(btnFirst);"
      }
    ]
  },
  {
    "name": "TableLayoutPanel",
    "methods": [
      {
        "name": "SetColumnSpan",
        "returnType": "void",
        "signature": "void SetColumnSpan(Control control, int value)",
        "description": "Makes a control span several columns.",
        "parameters": [
          {
            "name": "control",
            "type": "Control",
            "description": "The child control."
          },
          {
            "name": "value",
            "type": "int",
            "description": "The number of columns it should cover."
          }
        ],
        "returns": "Nothing.",
        "example": "tlp.SetColumnSpan(btnOk, 2);"
      },
      {
        "name": "SetRowSpan",
        "returnType": "void",
        "signature": "void SetRowSpan(Control control, int value)",
        "description": "Makes a control span several rows.",
        "parameters": [
          {
            "name": "control",
            "type": "Control",
            "description": "The child control."
          },
          {
            "name": "value",
            "type": "int",
            "description": "The number of rows it should cover."
          }
        ],
        "returns": "Nothing.",
        "example": "tlp.SetRowSpan(txtNotes, 2);"
      },
      {
        "name": "GetControlFromPosition",
        "returnType": "Control",
        "signature": "Control GetControlFromPosition(int column, int row)",
        "description": "Finds the control in a cell.",
        "parameters": [
          {
            "name": "column",
            "type": "int",
            "description": "The zero-based column."
          },
          {
            "name": "row",
            "type": "int",
            "description": "The zero-based row."
          }
        ],
        "returns": "The control, or null if the cell is empty.",
        "example": "Control cell = tlp.GetControlFromPosition(1, 0);"
      }
    ]
  }
]