      },
      {
        "name": "EnabledChanged",
        "description": "The Enabled property changes.",
        "delegate": "EventHandler",
        "eventArgsType": "EventArgs",
        "argumentsNote": "",
        "useCase": "",
        "example": "item.EnabledChanged += (s, e) => UpdateToolbar();"
      },
      {
        "name": "VisibleChanged",
        "description": "The Visible property changes.",
        "delegate": "EventHandler",
        "eventArgsType": "EventArgs",
        "argumentsNote": "",
        "useCase": "",
        "example": "item.VisibleChanged += (s, e) => UpdateToolbar();"
      },
      {
        "name": "TextChanged",
        "description": "The Text property changes.",
        "delegate": "EventHandler",
        "eventArgsType": "EventArgs",
        "argumentsNote": "",
